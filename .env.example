# Vorlage für .env (git-ignoriert, siehe CLAUDE.md-Konvention gegen versehentlich committete
# Kontodaten). Kopieren nach .env, eigene Werte eintragen, dann vor docker compose/dotnet ef/dotnet run
# IMMER "source tools/dev-env.sh" ausführen (nicht ./ - siehe CLAUDE.md).

# Nur EIN Variablensatz für Postgres, gelesen sowohl von docker-compose.yml (POSTGRES_USER/PASSWORD/DB
# im Container kommen von hier) als auch von den .NET-Projekten (server/src/Lumiis.Data/
# DbConnectionOptions.cs). LUMIIS_DB_HOST hat einen Code-Default (localhost) und muss hier nur gesetzt
# werden, wenn er abweicht.
LUMIIS_DB_NAME=lumiis
LUMIIS_DB_USER=lumiis
LUMIIS_DB_PASSWORD=change-me
LUMIIS_DB_PORT=5432

# Signier-Geheimnis für Session-Token (Lumiis.Auth), mindestens 32 Byte. Für echten Betrieb mit
# einem Zufallsgenerator erzeugen, z. B.: openssl rand -base64 48
LUMIIS_TOKEN_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long
