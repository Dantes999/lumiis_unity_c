<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="lumiis.uss" />
    <ui:VisualElement name="asset-lab-root" class="asset-lab-root">
        <ui:ScrollView class="asset-lab-scroll">
            <ui:Label text="Asset-Testlabor" class="asset-lab-title" />
            <ui:Label text="F10 schließt das Labor. Server-Figuren, Monster und das Debug-Overlay sind ausgeblendet; getestet wird eine lokale Vorschaufigur mit Trainingspuppen." class="asset-lab-hint" />

            <ui:Label text="Waffe" class="asset-lab-section" />
            <ui:VisualElement class="asset-lab-row">
                <ui:Label text="Waffe" class="asset-lab-label" />
                <ui:Button name="asset-lab-weapon-prev" text="&lt;" class="compact-button" />
                <ui:Label name="asset-lab-weapon-label" text="-" class="asset-lab-value" />
                <ui:Button name="asset-lab-weapon-next" text="&gt;" class="compact-button" />
            </ui:VisualElement>
            <ui:Label name="asset-lab-weapon-source" text="" class="asset-lab-hint" />
            <ui:VisualElement class="asset-lab-row">
                <ui:Label text="Stufe" class="asset-lab-label" />
                <ui:Button name="asset-lab-upgrade-prev" text="&lt;" class="compact-button" />
                <ui:Label name="asset-lab-upgrade-label" text="+0" class="asset-lab-value" />
                <ui:Button name="asset-lab-upgrade-next" text="&gt;" class="compact-button" />
            </ui:VisualElement>

            <ui:Label text="Rüstung &amp; Aussehen" class="asset-lab-section" />
            <ui:VisualElement class="asset-lab-row">
                <ui:Label text="Rüstung" class="asset-lab-label" />
                <ui:Button name="asset-lab-armor-prev" text="&lt;" class="compact-button" />
                <ui:Label name="asset-lab-armor-label" text="-" class="asset-lab-value" />
                <ui:Button name="asset-lab-armor-next" text="&gt;" class="compact-button" />
            </ui:VisualElement>
            <ui:VisualElement class="asset-lab-row">
                <ui:Label text="Helm" class="asset-lab-label" />
                <ui:Button name="asset-lab-helmet-prev" text="&lt;" class="compact-button" />
                <ui:Label name="asset-lab-helmet-label" text="-" class="asset-lab-value" />
                <ui:Button name="asset-lab-helmet-next" text="&gt;" class="compact-button" />
            </ui:VisualElement>
            <ui:VisualElement class="asset-lab-row">
                <ui:Label text="Schild" class="asset-lab-label" />
                <ui:Button name="asset-lab-shield-prev" text="&lt;" class="compact-button" />
                <ui:Label name="asset-lab-shield-label" text="-" class="asset-lab-value" />
                <ui:Button name="asset-lab-shield-next" text="&gt;" class="compact-button" />
            </ui:VisualElement>
            <ui:VisualElement class="asset-lab-row">
                <ui:Label text="Frisur" class="asset-lab-label" />
                <ui:Button name="asset-lab-hair-prev" text="&lt;" class="compact-button" />
                <ui:Label name="asset-lab-hair-label" text="-" class="asset-lab-value" />
                <ui:Button name="asset-lab-hair-next" text="&gt;" class="compact-button" />
            </ui:VisualElement>
            <ui:VisualElement class="asset-lab-row">
                <ui:Label text="Haarfarbe" class="asset-lab-label" />
                <ui:Button name="asset-lab-haircolor-prev" text="&lt;" class="compact-button" />
                <ui:Label name="asset-lab-haircolor-label" text="-" class="asset-lab-value" />
                <ui:Button name="asset-lab-haircolor-next" text="&gt;" class="compact-button" />
            </ui:VisualElement>

            <ui:Label text="Bewegung &amp; Animation" class="asset-lab-section" />
            <ui:Label text="Blickrichtung" class="asset-lab-label" />
            <ui:VisualElement class="asset-lab-row">
                <ui:Button name="asset-lab-facing-down" text="Unten" class="compact-button" />
                <ui:Button name="asset-lab-facing-up" text="Oben" class="compact-button" />
                <ui:Button name="asset-lab-facing-left" text="Links" class="compact-button" />
                <ui:Button name="asset-lab-facing-right" text="Rechts" class="compact-button" />
            </ui:VisualElement>
            <ui:VisualElement class="asset-lab-row">
                <ui:Button name="asset-lab-anim-idle" text="Idle" class="compact-button" />
                <ui:Button name="asset-lab-anim-walk" text="Laufen" class="compact-button" />
                <ui:Button name="asset-lab-anim-attack" text="Angriff" class="compact-button" />
            </ui:VisualElement>
            <ui:Label name="asset-lab-motion-label" text="Idle" class="asset-lab-hint" />

            <ui:Label text="Szene" class="asset-lab-section" />
            <ui:Label text="Die Szene wird für das Labor aufgeräumt: drei Trainingspuppen, keine Monster, keine anderen Spieler." class="asset-lab-hint" />
            <ui:Button name="asset-lab-dummy-reset" text="Trainingspuppen neu platzieren" class="asset-lab-wide-button" />
            <ui:Button name="asset-lab-reset" text="Figur zurücksetzen" class="asset-lab-wide-button" />
            <ui:Button name="asset-lab-screenshot" text="Screenshot aufnehmen (F12)" class="asset-lab-wide-button" />
            <ui:Button name="asset-lab-close" text="Labor schließen (F10)" class="asset-lab-wide-button asset-lab-close" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
