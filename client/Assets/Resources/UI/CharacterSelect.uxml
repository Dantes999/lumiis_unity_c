<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="lumiis.uss" />
    <ui:VisualElement name="character-select-root" class="screen character-select-screen">
        <ui:VisualElement name="character-select-backdrop" class="login-backdrop" picking-mode="Ignore" />
        <ui:VisualElement class="login-vignette" picking-mode="Ignore" />

        <ui:VisualElement class="login-center" picking-mode="Ignore">
            <ui:Label text="LUMIIS" class="login-logo login-logo-small" picking-mode="Ignore" />

            <ui:VisualElement class="m2-window charselect-window">
                <ui:VisualElement class="m2-titlebar">
                    <ui:Label text="Charakterauswahl" class="m2-title" />
                </ui:VisualElement>
                <ui:VisualElement class="m2-window-body charselect-body">
                    <ui:VisualElement class="m2-inset charselect-preview">
                        <ui:VisualElement name="charselect-preview-figure" class="charselect-preview-figure" picking-mode="Ignore" />
                        <ui:Label name="charselect-selected-name" text="-" class="charselect-selected-name" />
                        <ui:Label name="charselect-selected-info" text="Krieger" class="charselect-selected-info" />
                    </ui:VisualElement>

                    <ui:VisualElement class="charselect-right">
                        <ui:Label text="Deine Charaktere" class="m2-section" />
                        <ui:ScrollView name="character-list" class="m2-inset character-list" />
                        <ui:Label text="Neuen Charakter erschaffen" class="m2-section" />
                        <ui:VisualElement class="new-character-row">
                            <ui:TextField name="new-character-name-field" class="m2-input" />
                            <ui:Button text="Erstellen" name="create-character-button" class="m2-button" />
                        </ui:VisualElement>
                        <ui:Label name="character-select-status" class="status-text" />
                        <ui:Label name="character-select-error" class="error-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="charselect-actions">
                    <ui:Button text="Zurück" name="logout-button" class="m2-button" />
                    <ui:Button text="Spiel starten" name="start-game-button" class="m2-button primary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
