<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="lumiis.uss" />
    <ui:VisualElement name="escape-menu-root" class="screen">
        <ui:VisualElement class="panel">
            <ui:Label text="Menü" class="title" />
            <ui:VisualElement class="button-row">
                <ui:Button text="Charakter wechseln" name="escape-switch-character-button" />
            </ui:VisualElement>
            <ui:VisualElement class="button-row">
                <ui:Button text="Ausloggen" name="escape-logout-button" />
            </ui:VisualElement>
            <ui:VisualElement class="button-row">
                <ui:Button text="Beenden" name="escape-quit-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
