<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="lumiis.uss" />
    <ui:VisualElement name="login-root" class="screen login-screen">
        <ui:VisualElement name="login-backdrop" class="login-backdrop" />
        <ui:VisualElement class="login-layout">
            <ui:VisualElement class="login-brand">
                <ui:Label text="LUMIIS" class="login-logo" />
                <ui:Label text="Ein neues Kapitel beginnt." class="login-tagline" />
                <ui:Label text="Betritt die Welt von Yongan, stelle dich den Wildhunden und sammle deine erste Ausrüstung." class="login-copy" />
                <ui:VisualElement class="login-feature-row">
                    <ui:Label text="◆  Freies Abenteuer" class="login-feature" />
                    <ui:Label text="◆  Handel &amp; Gruppen" class="login-feature" />
                    <ui:Label text="◆  Lumiis-Steine" class="login-feature" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="panel login-card">
                <ui:Label text="Anmelden" class="login-title" />
                <ui:Label text="Willkommen zurück, Abenteurer." class="login-subtitle" />
                <ui:TextField label="Benutzername" name="username-field" class="login-input" />
                <ui:TextField label="Passwort" name="password-field" class="login-input" password="true" />
                <ui:VisualElement class="button-row login-actions">
                    <ui:Button text="Anmelden" name="login-button" class="primary-button" />
                    <ui:Button text="Registrieren" name="register-button" class="secondary-button" />
                </ui:VisualElement>
                <ui:Label name="login-status" class="status-text" />
                <ui:Label name="login-error" class="error-text" />
                <ui:Foldout text="Verbindung" name="advanced-foldout" value="false">
                    <ui:TextField label="Auth-URL" name="auth-url-field" value="http://127.0.0.1:5080" />
                    <ui:TextField label="Server-Host" name="server-host-field" value="127.0.0.1" />
                    <ui:TextField label="Server-Port" name="server-port-field" value="7777" />
                </ui:Foldout>
                <ui:Label text="Lumiis Alpha · Viel Spaß beim Testen" class="login-version" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
