/* Minimale, funktionale Gestaltung (lesbar, keine Design-Arbeit - das kommt später mit dem Art-Stil). */

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 8, 12, 0.85);
}

.panel {
    width: 420px;
    padding: 20px;
    background-color: rgb(30, 30, 36);
    border-width: 1px;
    border-color: rgb(60, 60, 70);
}

.title {
    font-size: 22px;
    color: rgb(235, 235, 240);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

/* Eingabefelder explizit groß/klar dimensioniert statt sich allein auf das Default-Theme zu verlassen -
   dessen Basiswerte machten die Felder kaum sichtbar/klickbar. */
.unity-text-field {
    min-height: 34px;
    margin-bottom: 10px;
}

.unity-text-field__label {
    color: rgb(210, 210, 215);
    min-width: 120px;
    font-size: 14px;
    -unity-text-align: middle-left;
}

.unity-text-field__input {
    background-color: rgb(18, 18, 22);
    color: rgb(235, 235, 240);
    border-width: 1px;
    border-color: rgb(90, 90, 105);
    border-radius: 3px;
    min-height: 30px;
    padding: 4px 8px;
    font-size: 14px;
    flex-grow: 1;
}

.unity-foldout {
    margin-top: 8px;
}

.unity-foldout__text {
    color: rgb(190, 190, 200);
}

.button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

Button {
    background-color: rgb(55, 90, 140);
    color: rgb(240, 240, 245);
    border-width: 0;
    border-radius: 4px;
    margin: 4px;
    padding: 8px 16px;
    min-height: 34px;
    min-width: 120px;
    font-size: 14px;
}

Button:hover {
    background-color: rgb(70, 105, 160);
}

Button:disabled {
    background-color: rgb(60, 60, 65);
    color: rgb(150, 150, 155);
}

.error-text {
    color: rgb(230, 100, 100);
    white-space: normal;
    margin-top: 8px;
    min-height: 18px;
}

.status-text {
    color: rgb(190, 190, 200);
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.character-list {
    height: 180px;
    margin-bottom: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 62);
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
}

.character-button {
    -unity-text-align: middle-left;
    background-color: rgb(40, 40, 48);
    margin: 2px 0;
}

.character-button:hover {
    background-color: rgb(55, 55, 65);
}

.new-character-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.new-character-row .unity-text-field {
    flex-grow: 1;
}

/* ---- Asset-Testlabor (Editor/Development, F10) ---- */

.asset-lab-root {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 390px;
    height: 92%;
}

.asset-lab-scroll {
    flex-grow: 1;
    height: 100%;
    background-color: rgba(18, 18, 24, 0.95);
    border-width: 1px;
    border-color: rgb(72, 82, 104);
    padding: 12px;
}

.asset-lab-title {
    font-size: 21px;
    color: rgb(235, 238, 245);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.asset-lab-hint {
    color: rgb(155, 160, 175);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 6px;
}

.asset-lab-section {
    color: rgb(150, 190, 255);
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 3px;
}

.asset-lab-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.asset-lab-label {
    width: 80px;
    color: rgb(205, 210, 220);
    font-size: 12px;
}

.asset-lab-value {
    flex-grow: 1;
    color: rgb(240, 240, 245);
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.compact-button {
    min-width: 28px;
    min-height: 24px;
    padding: 1px 6px;
    margin: 2px;
    font-size: 12px;
}

.asset-lab-wide-button {
    min-height: 30px;
    margin: 5px 2px 0 2px;
}

.asset-lab-close {
    background-color: rgb(120, 52, 52);
}

.asset-lab-close:hover {
    background-color: rgb(150, 64, 64);
}

.asset-lab-icon-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 6px;
}

.asset-lab-icon-cell {
    width: 40px;
    height: 40px;
    margin: 1px;
    align-items: center;
    justify-content: center;
    background-color: rgb(32, 34, 42);
    border-width: 1px;
    border-color: rgb(60, 65, 78);
}

.asset-lab-icon-cell Image {
    width: 32px;
    height: 32px;
}
