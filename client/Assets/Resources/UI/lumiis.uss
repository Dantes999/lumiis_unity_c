/* Minimale, funktionale Gestaltung (lesbar, keine Design-Arbeit - das kommt später mit dem Art-Stil). */

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 8, 12, 0.85);
}

.panel {
    width: 420px;
    padding: 20px;
    background-color: rgb(30, 30, 36);
    border-width: 1px;
    border-color: rgb(60, 60, 70);
}

.title {
    font-size: 22px;
    color: rgb(235, 235, 240);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

/* Eingabefelder explizit groß/klar dimensioniert statt sich allein auf das Default-Theme zu verlassen -
   dessen Basiswerte machten die Felder kaum sichtbar/klickbar. */
.unity-text-field {
    min-height: 34px;
    margin-bottom: 10px;
}

.unity-text-field__label {
    color: rgb(210, 210, 215);
    min-width: 120px;
    font-size: 14px;
    -unity-text-align: middle-left;
}

.unity-text-field__input {
    background-color: rgb(18, 18, 22);
    color: rgb(235, 235, 240);
    border-width: 1px;
    border-color: rgb(90, 90, 105);
    border-radius: 3px;
    min-height: 30px;
    padding: 4px 8px;
    font-size: 14px;
    flex-grow: 1;
}

.unity-foldout {
    margin-top: 8px;
}

.unity-foldout__text {
    color: rgb(190, 190, 200);
}

.button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

Button {
    background-color: rgb(55, 90, 140);
    color: rgb(240, 240, 245);
    border-width: 0;
    border-radius: 4px;
    margin: 4px;
    padding: 8px 16px;
    min-height: 34px;
    min-width: 120px;
    font-size: 14px;
}

Button:hover {
    background-color: rgb(70, 105, 160);
}

Button:disabled {
    background-color: rgb(60, 60, 65);
    color: rgb(150, 150, 155);
}

.error-text {
    color: rgb(230, 100, 100);
    white-space: normal;
    margin-top: 8px;
    min-height: 18px;
}

.status-text {
    color: rgb(190, 190, 200);
    -unity-text-align: middle-center;
    margin-top: 6px;
}

.character-list {
    height: 180px;
    margin-bottom: 12px;
    border-width: 1px;
    border-color: rgb(55, 55, 62);
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
}

.character-button {
    -unity-text-align: middle-left;
    background-color: rgb(40, 40, 48);
    margin: 2px 0;
}

.character-button:hover {
    background-color: rgb(55, 55, 65);
}

.new-character-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.new-character-row .unity-text-field {
    flex-grow: 1;
}

/* ---- Asset-Testlabor (Editor/Development, F10) ---- */

.asset-lab-root {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 390px;
    height: 92%;
}

.asset-lab-scroll {
    flex-grow: 1;
    height: 100%;
    background-color: rgba(18, 18, 24, 0.95);
    border-width: 1px;
    border-color: rgb(72, 82, 104);
    padding: 12px;
}

.asset-lab-title {
    font-size: 21px;
    color: rgb(235, 238, 245);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.asset-lab-hint {
    color: rgb(155, 160, 175);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 6px;
}

.asset-lab-section {
    color: rgb(150, 190, 255);
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 3px;
}

.asset-lab-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.asset-lab-label {
    width: 80px;
    color: rgb(205, 210, 220);
    font-size: 12px;
}

.asset-lab-value {
    flex-grow: 1;
    color: rgb(240, 240, 245);
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.compact-button {
    min-width: 28px;
    min-height: 24px;
    padding: 1px 6px;
    margin: 2px;
    font-size: 12px;
}

.asset-lab-wide-button {
    min-height: 30px;
    margin: 5px 2px 0 2px;
}

.asset-lab-close {
    background-color: rgb(120, 52, 52);
}

.asset-lab-close:hover {
    background-color: rgb(150, 64, 64);
}

.asset-lab-icon-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 6px;
}

.asset-lab-icon-cell {
    width: 40px;
    height: 40px;
    margin: 1px;
    align-items: center;
    justify-content: center;
    background-color: rgb(32, 34, 42);
    border-width: 1px;
    border-color: rgb(60, 65, 78);
}

.asset-lab-icon-cell Image {
    width: 32px;
    height: 32px;
}

/* ---- M7-HUD: dauerhaftes Spieler-/Ziel-/Skill-/Chat-Overlay ---- */

.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-player {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 270px;
    padding: 8px;
    background-color: rgba(15, 17, 22, 0.88);
    border-width: 1px;
    border-color: rgb(65, 75, 92);
    border-radius: 4px;
}

.hud-player-name {
    color: rgb(240, 240, 245);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.hud-map-name {
    color: rgb(180, 205, 225);
    font-size: 12px;
    margin-bottom: 6px;
}

.hud-bar-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.hud-bar-label {
    width: 34px;
    color: rgb(180, 185, 195);
    font-size: 10px;
}

.hud-bar-bg {
    flex-grow: 1;
    height: 10px;
    background-color: rgb(30, 30, 36);
    border-width: 1px;
    border-color: rgb(55, 60, 70);
    margin-right: 4px;
}

.hud-bar-fill {
    height: 8px;
    width: 100%;
}

.hud-bar-hp { background-color: rgb(190, 45, 45); }
.hud-bar-sp { background-color: rgb(50, 95, 190); }
.hud-bar-xp { background-color: rgb(180, 150, 45); }
.hud-bar-target { background-color: rgb(210, 70, 55); }

.hud-bar-text {
    width: 76px;
    color: rgb(205, 210, 220);
    font-size: 10px;
    -unity-text-align: middle-right;
}

.hud-yang {
    color: rgb(225, 195, 95);
    font-size: 11px;
    margin-top: 2px;
}

.hud-target {
    position: absolute;
    left: 50%;
    top: 10px;
    margin-left: -130px;
    width: 260px;
    padding: 6px 8px;
    background-color: rgba(15, 17, 22, 0.88);
    border-width: 1px;
    border-color: rgb(90, 62, 62);
    border-radius: 4px;
}

.hud-target-name {
    color: rgb(240, 220, 200);
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
}

.hud-message {
    position: absolute;
    left: 50%;
    top: 86px;
    margin-left: -220px;
    width: 440px;
    color: rgb(240, 220, 150);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hud-skills {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 460px;
    align-items: center;
}

.hud-skill-slots {
    flex-direction: row;
    justify-content: center;
}

.hud-skill-slot {
    width: 110px;
    margin: 0 2px;
    padding: 4px;
    background-color: rgba(15, 17, 22, 0.88);
    border-width: 1px;
    border-color: rgb(65, 75, 92);
    border-radius: 3px;
    align-items: center;
}

.hud-skill-key {
    color: rgb(235, 205, 110);
    font-size: 11px;
    -unity-font-style: bold;
}

.hud-skill-name {
    color: rgb(225, 230, 240);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.hud-skill-cd {
    color: rgb(150, 190, 255);
    font-size: 10px;
    min-height: 12px;
}

.hud-buffs {
    color: rgb(210, 210, 220);
    font-size: 10px;
    margin-top: 3px;
    -unity-text-align: middle-center;
}

.hud-chat {
    position: absolute;
    left: 10px;
    bottom: 10px;
    width: 360px;
    height: 210px;
    padding: 6px;
    background-color: rgba(15, 17, 22, 0.86);
    border-width: 1px;
    border-color: rgb(55, 65, 80);
    border-radius: 4px;
}

.hud-chat-log {
    height: 132px;
    background-color: rgba(8, 9, 12, 0.55);
    padding: 3px;
    margin-bottom: 3px;
}

.hud-chat-input-row {
    flex-direction: row;
    align-items: center;
}

.hud-chat-target {
    width: 74px;
    margin-right: 3px;
}

.hud-chat-input {
    flex-grow: 1;
    margin-right: 3px;
}

.hud-chat-channel-label {
    color: rgb(160, 170, 185);
    font-size: 10px;
    margin-right: 4px;
}

.hud-chat-channels {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.hud-chat-target, .hud-chat-input {
    min-height: 24px;
}

.hud-chat-target .unity-text-field__input, .hud-chat-input .unity-text-field__input {
    min-height: 22px;
    font-size: 11px;
}

.hud-chat-target .unity-text-field__label {
    min-width: 18px;
    font-size: 10px;
}

.hud-chat-send, .hud-chat-channel-button {
    min-width: 50px;
    min-height: 24px;
    padding: 1px 6px;
    margin: 1px;
    font-size: 10px;
}

.hud-chat-line {
    color: rgb(220, 225, 235);
    font-size: 11px;
    white-space: normal;
}

.hud-chat-system { color: rgb(235, 205, 110); }
.hud-chat-whisper { color: rgb(180, 210, 255); }
.hud-chat-global { color: rgb(160, 225, 180); }

.hud-party {
    position: absolute;
    right: 10px;
    top: 10px;
    width: 270px;
    padding: 6px 8px;
    background-color: rgba(15, 17, 22, 0.88);
    border-width: 1px;
    border-color: rgb(65, 75, 92);
    border-radius: 4px;
}

.hud-party-title {
    color: rgb(150, 190, 255);
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.hud-party-members {
    flex-direction: column;
}

.hud-party-hint {
    color: rgb(150, 155, 165);
    font-size: 9px;
    white-space: normal;
    margin-top: 2px;
}

.hud-party-leave {
    min-width: 80px;
    min-height: 22px;
    padding: 1px 6px;
    margin: 3px 0 0 0;
    font-size: 10px;
    background-color: rgb(95, 55, 55);
}

/* ---- Release-Optik: Minimap, zentrale Skillleiste, dezenter Chat ---- */

.hud-minimap {
    position: absolute;
    right: 10px;
    top: 10px;
    width: 170px;
    padding: 5px;
    background-color: rgba(12, 15, 18, 0.82);
    border-width: 1px;
    border-color: rgba(160, 135, 80, 0.65);
    border-radius: 4px;
    align-items: center;
}

.hud-minimap-title {
    color: rgb(230, 215, 170);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
}

.hud-minimap-frame {
    width: 158px;
    height: 158px;
    background-color: rgb(30, 44, 28);
    border-width: 1px;
    border-color: rgb(35, 42, 30);
    -unity-background-scale-mode: scale-to-fit;
    overflow: hidden;
}

.hud-minimap-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    background-color: rgb(255, 224, 80);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(80, 55, 10);
}

.hud-party {
    top: 190px;
}

.hud-skills {
    left: 50%;
    right: auto;
    margin-left: -230px;
    bottom: 10px;
    width: 460px;
}

.hud-hint {
    color: rgba(235, 230, 210, 0.72);
    font-size: 10px;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
}

.hud-skill-slots {
    flex-direction: row;
    justify-content: center;
}

.hud-skill-slot {
    width: 76px;
    height: 84px;
    margin: 0 3px;
    padding: 4px;
    background-color: rgba(12, 15, 18, 0.88);
    border-width: 1px;
    border-color: rgba(160, 135, 80, 0.65);
    border-radius: 4px;
    align-items: center;
}

.hud-skill-icon {
    width: 34px;
    height: 34px;
    margin: 1px;
}

.hud-skill-key {
    color: rgb(245, 220, 140);
    font-size: 10px;
    -unity-font-style: bold;
}

.hud-skill-name {
    color: rgb(235, 235, 225);
    font-size: 9px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.hud-skill-cd {
    color: rgb(255, 190, 100);
    font-size: 10px;
    min-height: 11px;
    -unity-text-align: middle-center;
}

.hud-chat {
    width: 330px;
    height: 188px;
    background-color: rgba(10, 12, 15, 0.72);
    border-color: rgba(120, 110, 80, 0.45);
}

.hud-chat-log {
    height: 112px;
}

.hud-chat-line {
    font-size: 10px;
}

.hud-player {
    width: 258px;
    background-color: rgba(10, 12, 15, 0.78);
    border-color: rgba(120, 110, 80, 0.55);
}

.hud-target {
    background-color: rgba(10, 12, 15, 0.82);
    border-color: rgba(150, 90, 80, 0.7);
}

.hud-skill-icon {
    -unity-background-scale-mode: scale-to-fit;
}

.hud-skills {
    left: auto;
    right: 10px;
    margin-left: 0;
    width: 460px;
}

.hud-skill-icon-image {
    width: 34px;
    height: 34px;
}

.hud-skill-slot {
    height: 96px;
}

/* ---- Login / Charakterauswahl: Release-Optik ---- */

.login-screen,
.character-select-screen {
    background-color: rgb(7, 12, 9);
}

.login-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.32;
    -unity-background-scale-mode: scale-and-crop;
}

.login-layout {
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 24px;
}

.login-brand {
    width: 330px;
    margin-right: 40px;
}

.login-logo {
    color: rgb(236, 205, 128);
    font-size: 52px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.login-tagline {
    color: rgb(240, 240, 230);
    font-size: 20px;
    margin-bottom: 14px;
}

.login-copy {
    color: rgba(225, 230, 220, 0.78);
    font-size: 13px;
    white-space: normal;
}

.login-feature-row {
    margin-top: 24px;
}

.login-feature {
    color: rgba(220, 198, 145, 0.9);
    font-size: 12px;
    margin: 5px 0;
}

.login-card {
    width: 370px;
    padding: 28px;
    background-color: rgba(12, 17, 13, 0.94);
    border-width: 1px;
    border-color: rgba(166, 139, 82, 0.6);
    border-radius: 6px;
}

.character-card {
    width: 430px;
}

.login-title {
    color: rgb(242, 236, 218);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-bottom: 2px;
}

.login-subtitle {
    color: rgba(200, 208, 196, 0.72);
    font-size: 12px;
    margin-bottom: 18px;
}

.login-input {
    margin-bottom: 6px;
}

.login-actions {
    margin-top: 18px;
    justify-content: flex-start;
}

.primary-button {
    background-color: rgb(150, 103, 43);
    color: rgb(255, 244, 219);
    min-width: 145px;
}

.primary-button:hover {
    background-color: rgb(181, 126, 54);
}

.secondary-button {
    background-color: rgba(48, 58, 48, 0.9);
    color: rgb(225, 230, 220);
    border-width: 1px;
    border-color: rgba(126, 142, 118, 0.55);
}

.secondary-button:hover {
    background-color: rgba(64, 78, 64, 0.95);
}

.login-version {
    color: rgba(170, 178, 165, 0.55);
    font-size: 10px;
    margin-top: 14px;
    -unity-text-align: middle-left;
}

.character-card .character-list {
    height: 210px;
    background-color: rgba(5, 8, 6, 0.6);
    border-color: rgba(100, 116, 94, 0.45);
    padding: 4px;
}

.character-card .character-button {
    min-height: 38px;
    margin: 3px 0;
    background-color: rgba(32, 45, 34, 0.95);
    color: rgb(235, 238, 228);
    border-width: 1px;
    border-color: rgba(100, 116, 94, 0.35);
    -unity-text-align: middle-left;
    padding-left: 12px;
}

.character-card .character-button:hover {
    background-color: rgba(54, 72, 53, 0.95);
    border-color: rgba(190, 158, 86, 0.65);
}
