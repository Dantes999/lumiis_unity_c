/* Lumiis-UI im klassischen MMO-Stil (dunkler Stein, Bronze-/Goldkanten, Pixelart-Rahmen).
   Alle Maße beziehen sich auf die Referenzauflösung 1280x720 (UiSkin.CreatePanelSettings skaliert mit).
   Skin-Texturen: Resources/UI/Skin, erzeugt von tools/generate-ui-skin.py. */

/* ================= Grundbausteine ================= */

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 3, 2, 0.7);
}

.m2-window {
    background-image: resource("UI/Skin/panel");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    padding: 6px 6px 10px 6px;
}

.m2-panel {
    background-image: resource("UI/Skin/panel");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    padding: 9px;
}

.m2-titlebar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 22px;
    margin-bottom: 4px;
    background-image: resource("UI/Skin/titlebar");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
}

.m2-title {
    flex-grow: 1;
    color: rgb(246, 222, 160);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(30, 8, 4);
    padding: 0;
    margin: 0;
}

.m2-window-body {
    padding: 6px 8px 2px 8px;
}

.m2-inset {
    background-image: resource("UI/Skin/panel_inset");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    padding: 4px;
}

.m2-section {
    color: rgb(226, 190, 112);
    font-size: 14px;
    -unity-font-style: bold;
    margin: 6px 0 3px 0;
}

/* ---- Knöpfe (gilt für alle Buttons, auch Asset-Testlabor) ---- */

.unity-button {
    background-image: resource("UI/Skin/button");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(250, 232, 190);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(24, 12, 4);
    margin: 3px;
    padding: 4px 12px;
    min-height: 26px;
}

.unity-button:hover {
    background-image: resource("UI/Skin/button_hover");
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 246, 214);
}

.unity-button:active {
    background-image: resource("UI/Skin/button_pressed");
    background-color: rgba(0, 0, 0, 0);
}

.unity-button:disabled {
    background-image: resource("UI/Skin/button_disabled");
    color: rgb(150, 140, 128);
}

.m2-button {
    min-width: 96px;
}

.primary-button {
    color: rgb(255, 236, 160);
}

.m2-close {
    position: absolute;
    right: 4px;
    top: 3px;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin: 0;
    padding: 0;
    background-image: resource("UI/Skin/close");
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.m2-close:hover,
.m2-close:active {
    background-image: resource("UI/Skin/close_hover");
}

/* ---- Eingabefelder ---- */

.m2-input {
    margin: 2px 0;
    min-height: 24px;
}

.m2-input .unity-base-text-field__input,
.m2-input .unity-text-field__input {
    background-image: resource("UI/Skin/input");
    -unity-slice-left: 4;
    -unity-slice-right: 4;
    -unity-slice-top: 4;
    -unity-slice-bottom: 4;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: rgb(240, 228, 200);
    font-size: 15px;
    min-height: 24px;
    padding: 3px 8px;
    flex-grow: 1;
}

.m2-input:focus .unity-base-text-field__input,
.m2-input .unity-base-text-field__input:focus {
    background-image: resource("UI/Skin/input_focus");
}

.m2-input > .unity-label {
    color: rgb(214, 196, 160);
    font-size: 14px;
    min-width: 90px;
    -unity-text-align: middle-left;
}

.m2-foldout {
    margin-top: 6px;
}

.m2-foldout .unity-foldout__text {
    color: rgb(190, 170, 130);
    font-size: 13px;
}

.m2-toggle {
    margin: 4px 0 2px 0;
    align-items: center;
}

.m2-toggle .unity-toggle__input {
    align-items: center;
}

.m2-toggle .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: resource("UI/Skin/checkbox");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.m2-toggle:checked .unity-toggle__checkmark {
    background-image: resource("UI/Skin/checkbox_checked");
}

.m2-toggle:hover .unity-toggle__checkmark {
    -unity-background-image-tint-color: rgb(255, 236, 190);
}

.m2-toggle .unity-toggle__text,
.m2-toggle > .unity-label {
    color: rgb(214, 196, 160);
    font-size: 13px;
}

.button-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

.error-text {
    color: rgb(255, 110, 90);
    font-size: 13px;
    white-space: nowrap; /* lange Namen nie mitten im Wort umbrechen */
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
    margin-top: 2px;
    min-height: 16px;
}

.status-text {
    color: rgb(220, 205, 170);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-top: 4px;
}

/* ================= Login / Charakterauswahl ================= */

.login-screen,
.character-select-screen {
    background-color: rgb(10, 8, 6);
}

.login-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.55;
    -unity-background-scale-mode: scale-and-crop;
}

.login-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: resource("UI/Skin/vignette");
    -unity-background-scale-mode: stretch-to-fill;
}

.login-center {
    align-items: center;
    justify-content: center;
}

.login-header {
    align-items: center;
    margin-bottom: 18px;
}

.login-logo {
    color: rgb(240, 196, 96);
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(52, 22, 6);
    text-shadow: 3px 3px 0 rgba(0, 0, 0, 0.8);
    letter-spacing: 6px;
}

.login-logo-small {
    font-size: 40px;
    margin-bottom: 10px;
}

.login-tagline {
    color: rgb(232, 214, 176);
    font-size: 17px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(20, 10, 4);
}

.login-window {
    width: 330px;
}

.login-field-row {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
}

.login-field-label {
    width: 72px;
    color: rgb(226, 204, 158);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin-right: 8px;
}

.login-input {
    flex-grow: 1;
}

.login-actions {
    margin-top: 10px;
}

.login-footer {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.login-version {
    color: rgba(220, 200, 160, 0.6);
    font-size: 13px;
}

.charselect-window {
    width: 640px;
}

.charselect-body {
    flex-direction: row;
}

.charselect-preview {
    width: 200px;
    height: 250px;
    align-items: center;
    margin-right: 10px;
}

.charselect-preview-figure {
    width: 144px;
    height: 144px;
    margin-top: 22px;
    margin-bottom: 14px;
}

.charselect-selected-name {
    color: rgb(250, 230, 170);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(20, 10, 4);
}

.charselect-selected-info {
    color: rgb(200, 184, 150);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.charselect-right {
    flex-grow: 1;
}

.character-list {
    height: 132px;
    flex-grow: 0;
    flex-shrink: 0;
}

.character-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.charslot {
    width: 92px;
    height: 56px;
    margin: 3px;
    padding: 4px 2px;
    min-width: 0;
    background-image: resource("UI/Skin/charslot");
    -unity-slice-left: 10;
    -unity-slice-right: 10;
    -unity-slice-top: 10;
    -unity-slice-bottom: 10;
    color: rgb(230, 214, 180);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.charslot:hover {
    background-image: resource("UI/Skin/charslot_selected");
}

.charslot-selected {
    background-image: resource("UI/Skin/charslot_selected");
    color: rgb(255, 236, 160);
}

.new-character-row {
    flex-direction: row;
    align-items: center;
}

.new-character-row .m2-input {
    flex-grow: 1;
}

.charselect-look-row {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.charselect-look-label {
    width: 84px;
    color: rgb(214, 196, 160);
    font-size: 14px;
}

.charselect-look-arrow {
    min-width: 26px;
    width: 26px;
    min-height: 24px;
    padding: 0;
    margin: 0 2px;
}

.charselect-look-value {
    flex-grow: 1;
    color: rgb(240, 232, 214);
    font-size: 14px;
    -unity-text-align: middle-center;
}

.charselect-look-color-cell {
    align-items: center;
    justify-content: center;
}

.charselect-look-swatch {
    width: 40px;
    height: 16px;
    border-width: 1px;
    border-color: rgb(214, 180, 110); /* heller Rahmen, damit auch Schwarz sichtbar bleibt */
}

.charselect-actions {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 8px 0 8px;
}

.escape-screen {
    background-color: rgba(0, 0, 0, 0.45);
}

.escape-window {
    width: 240px;
}

.escape-body {
    align-items: stretch;
}

.escape-button {
    margin: 3px 4px;
}

/* ================= HUD ================= */

.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-root Label {
    padding: 0;
    margin: 0;
}

/* ---- Spieler-Plakette oben links ---- */

.hud-player {
    position: absolute;
    left: 10px;
    top: 8px;
    padding: 4px 10px 5px 8px;
    background-color: rgba(0, 0, 0, 0.5);
    border-width: 1px;
    border-color: rgba(150, 110, 60, 0.7);
    border-radius: 3px;
}

.hud-player-name {
    color: rgb(255, 232, 150);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(16, 8, 2);
}

.hud-player-level {
    color: rgb(250, 242, 220);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(16, 8, 2);
}

.hud-buffs {
    color: rgb(160, 230, 160);
    font-size: 13px;
    margin-top: 4px;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(8, 16, 4);
}

/* ---- Ziel oben mittig ---- */

.hud-target {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 240px;
    margin-left: -120px;
    align-items: center;
}

.hud-target-name {
    color: rgb(255, 214, 180);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(20, 4, 2);
    margin-bottom: 2px;
}

.hud-target-bar {
    width: 240px;
    height: 18px;
    padding: 2px;
    background-image: resource("UI/Skin/bar_frame");
    -unity-slice-left: 3;
    -unity-slice-right: 3;
    -unity-slice-top: 3;
    -unity-slice-bottom: 3;
}

.hud-target-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(186, 30, 22);
    border-top-width: 1px;
    border-top-color: rgb(240, 110, 90);
}

.hud-target-text {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    color: rgb(255, 240, 230);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-message {
    position: absolute;
    left: 50%;
    top: 62px;
    width: 520px;
    margin-left: -260px;
    color: rgb(255, 226, 140);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(20, 10, 2);
    white-space: normal;
}

/* ---- Runde Minimap oben rechts ---- */

.hud-minimap {
    position: absolute;
    right: 10px;
    top: 6px;
    width: 176px;
    height: 218px;
    align-items: center;
}

.hud-minimap-title {
    color: rgb(250, 226, 160);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(16, 8, 2);
    height: 20px;
}

.hud-minimap-frame {
    position: absolute;
    left: 14px;
    top: 34px;
    width: 148px;
    height: 148px;
    border-radius: 74px;
    overflow: hidden;
    background-color: rgb(24, 34, 20);
}

.hud-minimap-map {
    position: absolute;
    width: 444px;
    height: 444px;
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-minimap-dot {
    position: absolute;
    left: 70px;
    top: 70px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(255, 230, 60);
    border-width: 1px;
    border-color: rgb(60, 30, 0);
}

.hud-minimap-ring {
    position: absolute;
    left: 0;
    top: 20px;
    width: 176px;
    height: 176px;
    background-image: resource("UI/Skin/minimap_frame");
}

.hud-minimap-coords {
    position: absolute;
    left: 0;
    right: 0;
    top: 198px;
    color: rgb(255, 244, 214);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
    -unity-text-outline-width: 0px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

/* ---- Gruppe ---- */

.hud-party {
    position: absolute;
    right: 12px;
    top: 232px;
    width: 180px;
}

.hud-party-title {
    color: rgb(246, 222, 160);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.hud-party-member {
    color: rgb(230, 220, 200);
    font-size: 13px;
}

.hud-small-button {
    min-width: 60px;
    min-height: 22px;
    font-size: 12px;
    padding: 1px 6px;
}

/* ---- Chat unten links ---- */

.hud-chat {
    position: absolute;
    left: 112px;
    bottom: 70px;
    width: 340px;
}

.hud-chat-log {
    height: 120px;
    background-color: rgba(0, 0, 0, 0.55);
    padding: 3px 5px;
}

.hud-chat-line {
    color: rgb(248, 244, 232);
    font-size: 14px;
    white-space: normal;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
}

.hud-chat-system { color: rgb(255, 214, 110); }
.hud-chat-whisper { color: rgb(240, 150, 255); }
.hud-chat-global { color: rgb(150, 230, 255); }

.hud-chat-input-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 2px;
}

.hud-chat-channel-button {
    min-width: 58px;
    min-height: 24px;
    font-size: 12px;
    padding: 1px 4px;
    margin: 1px;
}

.hud-chat-target {
    width: 80px;
    margin-right: 2px;
}

.hud-chat-input {
    flex-grow: 1;
}

.hud-chat-send {
    min-width: 50px;
    min-height: 24px;
    font-size: 12px;
    padding: 1px 4px;
    margin: 1px;
}

.hud-chat-hint {
    color: rgb(245, 236, 210);
    font-size: 13px;
    margin-top: 1px;
    padding: 1px 4px;
    background-color: rgba(0, 0, 0, 0.6);
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

/* ---- Taskleiste unten ---- */

.hud-taskbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 64px;
    background-image: resource("UI/Skin/taskbar");
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 6;
    -unity-slice-bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
    padding-left: 116px; /* Platz für die HP-Kugel, damit Slot 1 sie nie berührt */
    padding-right: 116px;
}

.hud-taskbar-center {
    flex-direction: row;
    flex-shrink: 0; /* natürliche Breite messen, HudController.FitTaskbarCenter skaliert bei Platzmangel */
    align-items: center;
    margin-top: 4px;
}

.hud-quickslots {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.hud-quickslot {
    width: 40px;
    height: 40px;
    margin: 0 3px;
    background-image: resource("UI/Skin/slot");
    -unity-slice-left: 4;
    -unity-slice-right: 4;
    -unity-slice-top: 4;
    -unity-slice-bottom: 4;
    align-items: center;
    justify-content: center;
}

.hud-quickslot:hover {
    background-image: resource("UI/Skin/slot_hover");
}

.hud-quickslot-icon {
    width: 32px;
    height: 32px;
}

.hud-quickslot-cd {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    color: rgb(255, 240, 200);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-quickslot-cooling {
    background-color: rgba(0, 0, 0, 0.6);
}

.hud-quickslot-level {
    position: absolute;
    right: 3px;
    bottom: 1px;
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-quickslot-key {
    position: absolute;
    left: -3px;
    top: -5px;
    padding: 0 3px;
    background-color: rgba(10, 8, 6, 0.85);
    border-width: 1px;
    border-color: rgb(120, 96, 58);
    border-radius: 2px;
    color: rgb(255, 214, 110);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-quickslot-locked {
    opacity: 0.45;
}

.hud-exp {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.hud-exp-label {
    color: rgb(250, 226, 140);
    font-size: 13px;
    -unity-font-style: bold;
    margin-right: 4px;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-exp-orb {
    width: 18px;
    height: 18px;
    margin: 0 1px;
    background-image: resource("UI/Skin/exp_orb_empty");
    overflow: hidden;
}

.hud-exp-orb-fill {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 18px;
    height: 0;
    overflow: hidden;
}

/* Kind wird per Code eingefügt (volle Kugel, unten verankert) */
.hud-exp-orb-fill-image {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 18px;
    height: 18px;
    background-image: resource("UI/Skin/exp_orb_full");
}

.hud-exp-text {
    color: rgb(255, 236, 170);
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 5px;
    width: 66px;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

.hud-menu-buttons {
    flex-direction: row;
}

.hud-menu-button {
    min-width: 0;
    min-height: 24px;
    padding: 2px 7px;
    font-size: 12px;
    margin: 1px;
}

.hud-taskbar-yang {
    position: absolute;
    right: 112px;
    bottom: 68px;
    padding: 2px 8px;
    background-color: rgba(0, 0, 0, 0.55);
    border-width: 1px;
    border-color: rgba(150, 110, 60, 0.7);
    border-radius: 3px;
    color: rgb(255, 222, 110);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(0, 0, 0);
}

/* ---- HP/SP-Kugeln ---- */

.hud-orb {
    position: absolute;
    bottom: 4px;
    width: 100px;
    height: 100px;
}

.hud-orb-hp { left: 6px; }
.hud-orb-sp { right: 6px; }

.hud-orb-empty {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 84px;
    height: 84px;
    background-image: resource("UI/Skin/orb_empty");
}

.hud-orb-fill {
    position: absolute;
    left: 8px;
    bottom: 8px;
    width: 84px;
    height: 84px;
    overflow: hidden;
}

.hud-orb-fill-image {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 84px;
    height: 84px;
}

.hud-orb-fill-hp { background-image: resource("UI/Skin/orb_hp"); }
.hud-orb-fill-sp { background-image: resource("UI/Skin/orb_sp"); }

.hud-orb-glass {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 84px;
    height: 84px;
    background-image: resource("UI/Skin/orb_glass");
}

.hud-orb-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 100px;
    height: 100px;
    background-image: resource("UI/Skin/orb_frame");
}

.hud-orb-caption {
    position: absolute;
    left: 0;
    right: 0;
    top: 30px;
    color: rgba(255, 245, 230, 0.85);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-orb-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 46px;
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(0, 0, 0);
}

/* ---- Fenster (Inventar/Charakter/Shop) ---- */

.hud-window {
    position: absolute;
    display: none;
}

.hud-inventory-window {
    right: 196px;
    top: 90px;
    width: 232px;
}

.hud-character-window {
    left: 16px;
    top: 90px;
    width: 250px;
}

.hud-shop-window {
    left: 280px;
    top: 90px;
    width: 232px;
}

.hud-equip-area {
    height: 140px;
    margin-bottom: 4px;
}

.hud-equip-silhouette {
    position: absolute;
    left: 50%;
    top: 14px;
    width: 64px;
    height: 96px;
    margin-left: -32px;
    background-image: resource("UI/Skin/silhouette");
}

.hud-equip-slot {
    position: absolute;
}

.hud-equip-label {
    position: absolute;
    color: rgb(190, 170, 130);
    font-size: 11px;
}

.hud-item-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.hud-item-slot {
    width: 38px;
    height: 38px;
    margin: 1px;
    background-image: resource("UI/Skin/slot");
    -unity-slice-left: 4;
    -unity-slice-right: 4;
    -unity-slice-top: 4;
    -unity-slice-bottom: 4;
    align-items: center;
    justify-content: center;
}

.hud-item-slot:hover {
    background-image: resource("UI/Skin/slot_hover");
}

.hud-item-slot-selected {
    background-image: resource("UI/Skin/slot_selected");
}

.hud-item-icon {
    width: 30px;
    height: 30px;
}

.hud-item-text {
    color: rgb(230, 214, 180);
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.hud-item-badge {
    position: absolute;
    right: 3px;
    bottom: 1px;
    color: rgb(255, 230, 120);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-color: rgb(0, 0, 0);
}

.hud-upgrade-row {
    flex-direction: row;
    align-items: center;
}

.hud-window-hint {
    color: rgb(200, 184, 150);
    font-size: 12px;
    white-space: normal;
    margin: 4px 0 8px 0;
}

.hud-window-hint-active {
    color: rgb(255, 220, 120);
}

.hud-yang-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 4px;
}

.hud-yang-value {
    color: rgb(255, 222, 110);
    font-size: 14px;
    -unity-font-style: bold;
}

.hud-stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 22px;
}

.hud-stat-name {
    color: rgb(214, 196, 160);
    font-size: 13px;
}

.hud-stat-value {
    color: rgb(255, 245, 225);
    font-size: 13px;
    -unity-font-style: bold;
    flex-grow: 1;
    -unity-text-align: middle-right;
    margin-right: 4px;
}

.hud-plus-button {
    min-width: 22px;
    width: 22px;
    min-height: 20px;
    height: 20px;
    padding: 0;
    margin: 1px;
    font-size: 13px;
}

/* ---- Schmied ---- */

.hud-smith-window {
    left: 280px;
    top: 90px;
    width: 260px;
}

.hud-smith-slots {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 6px;
}

.hud-smith-slot {
    margin: 0 4px;
}

.hud-smith-details {
    padding: 6px 8px;
    min-height: 120px;
}

.hud-smith-item {
    color: rgb(255, 232, 150);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}

.hud-smith-step,
.hud-smith-line {
    color: rgb(236, 226, 204);
    font-size: 13px;
    white-space: normal;
}

.hud-smith-chance {
    color: rgb(150, 230, 140);
    font-size: 14px;
    -unity-font-style: bold;
}

.hud-smith-chance-low {
    color: rgb(255, 150, 110);
}

.hud-smith-warning {
    color: rgb(255, 140, 110);
    font-size: 13px;
    white-space: normal;
}

.hud-smith-upgrade {
    margin-top: 6px;
    min-height: 30px;
    font-size: 15px;
    -unity-font-style: bold;
}

.hud-smith-result {
    color: rgb(255, 222, 130);
    font-size: 13px;
    white-space: normal;
    -unity-text-align: middle-center;
    min-height: 18px;
    margin: 4px 0;
}

/* ---- Gruppeneinladung / Kontextmenü ---- */

.hud-party-invite {
    position: absolute;
    display: none;
    left: 50%;
    top: 34%;
    width: 300px;
    margin-left: -150px;
}

.hud-dialog-text {
    color: rgb(246, 236, 214);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 6px 0 10px 0;
}

.hud-dialog-buttons {
    flex-direction: row;
    justify-content: center;
}

.hud-dialog-buttons > .unity-button {
    min-width: 110px;
    margin: 0 6px;
}

.hud-context-menu {
    position: absolute;
    display: none;
    width: 200px;
    padding: 6px;
}

.hud-context-title {
    color: rgb(255, 232, 150);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.hud-context-button {
    margin: 2px 0;
}

/* ---- Gruppe: Mitgliederzeilen ---- */

.hud-party-row {
    margin: 2px 0 4px 0;
}

.hud-party-row-offline {
    opacity: 0.5;
}

.hud-party-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hud-party-role {
    flex-shrink: 0;
    margin-left: 4px;
    font-size: 11px;
    color: rgb(214, 196, 160);
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.95);
    -unity-text-outline-width: 0;
}

.hud-party-role-attacker {
    color: rgb(255, 150, 110);
}

.hud-party-role-defender {
    color: rgb(140, 190, 255);
}

.hud-context-danger {
    color: rgb(255, 150, 130);
}

.hud-party-name {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: rgb(240, 232, 214);
    font-size: 13px;
}

.hud-party-name-leader {
    color: rgb(255, 222, 110);
    -unity-font-style: bold;
}

.hud-party-hp {
    height: 8px;
    background-color: rgb(40, 14, 12);
    border-width: 1px;
    border-color: rgb(10, 6, 4);
}

.hud-party-hp-fill {
    height: 100%;
    background-color: rgb(196, 40, 32);
}

/* ---- Tooltip ---- */

.hud-tooltip {
    position: absolute;
    display: none;
    max-width: 220px;
    padding: 6px 8px;
    background-image: resource("UI/Skin/tooltip");
    -unity-slice-left: 3;
    -unity-slice-right: 3;
    -unity-slice-top: 3;
    -unity-slice-bottom: 3;
}

.hud-tooltip-title {
    color: rgb(255, 222, 130);
    font-size: 14px;
    -unity-font-style: bold;
}

.hud-tooltip-body {
    color: rgb(230, 220, 200);
    font-size: 13px;
    white-space: normal;
}

/* ---- Asset-Testlabor (Editor/Development, F10) ---- */

.asset-lab-root {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 390px;
    height: 92%;
}

.asset-lab-scroll {
    flex-grow: 1;
    height: 100%;
    background-color: rgba(18, 18, 24, 0.95);
    border-width: 1px;
    border-color: rgb(72, 82, 104);
    padding: 12px;
}

.asset-lab-title {
    font-size: 21px;
    color: rgb(235, 238, 245);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.asset-lab-hint {
    color: rgb(155, 160, 175);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 6px;
}

.asset-lab-section {
    color: rgb(150, 190, 255);
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 3px;
}

.asset-lab-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.asset-lab-label {
    width: 80px;
    color: rgb(205, 210, 220);
    font-size: 12px;
}

.asset-lab-value {
    flex-grow: 1;
    color: rgb(240, 240, 245);
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.compact-button {
    min-width: 28px;
    min-height: 24px;
    padding: 1px 6px;
    margin: 2px;
    font-size: 12px;
}

.asset-lab-wide-button {
    min-height: 30px;
    margin: 5px 2px 0 2px;
}

.asset-lab-close {
    background-color: rgb(120, 52, 52);
}

.asset-lab-close:hover {
    background-color: rgb(150, 64, 64);
}

.asset-lab-icon-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 6px;
}

.asset-lab-icon-cell {
    width: 40px;
    height: 40px;
    margin: 1px;
    align-items: center;
    justify-content: center;
    background-color: rgb(32, 34, 42);
    border-width: 1px;
    border-color: rgb(60, 65, 78);
}

.asset-lab-icon-cell Image {
    width: 32px;
    height: 32px;
}

