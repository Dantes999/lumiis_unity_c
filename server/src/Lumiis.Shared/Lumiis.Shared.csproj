<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Lumiis.Shared</RootNamespace>
  </PropertyGroup>

  <!-- Kopiert Lumiis.Shared.dll und LiteNetLib.dll (netstandard2.1) nach client/Assets/Plugins/Lumiis/,
       aber nur wenn ein Unity-Client-Checkout vorhanden ist. Keine PDBs, plattformunabhängig. -->
  <Target Name="CopyToUnityPlugins" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)../../../client/Assets')">
    <PropertyGroup>
      <UnityPluginsDir>$(MSBuildThisFileDirectory)../../../client/Assets/Plugins/Lumiis/</UnityPluginsDir>
      <LiteNetLibDll>$(NuGetPackageRoot)litenetlib/$(LiteNetLibVersion)/lib/netstandard2.1/LiteNetLib.dll</LiteNetLibDll>
      <UnityDataDir>$(MSBuildThisFileDirectory)../../../client/Assets/StreamingAssets/lumiis-data/</UnityDataDir>
      <LooksJsonSource>$(MSBuildThisFileDirectory)../../../data/looks.json</LooksJsonSource>
      <ItemsJsonSource>$(MSBuildThisFileDirectory)../../../data/items.json</ItemsJsonSource>
      <SkillsJsonSource>$(MSBuildThisFileDirectory)../../../data/skills.json</SkillsJsonSource>
      <ClassesJsonSource>$(MSBuildThisFileDirectory)../../../data/classes.json</ClassesJsonSource>
      <UpgradeJsonSource>$(MSBuildThisFileDirectory)../../../data/upgrade.json</UpgradeJsonSource>
      <MapsDataDir>$(MSBuildThisFileDirectory)../../../data/maps/</MapsDataDir>
    </PropertyGroup>
    <ItemGroup>
      <UnityPluginFiles Include="$(TargetPath)" />
      <UnityPluginFiles Include="$(LiteNetLibDll)" Condition="Exists('$(LiteNetLibDll)')" />
    </ItemGroup>
    <ItemGroup>
      <UnityDataFiles Include="$(LooksJsonSource)" Condition="Exists('$(LooksJsonSource)')" />
      <UnityDataFiles Include="$(ItemsJsonSource)" Condition="Exists('$(ItemsJsonSource)')" />
      <UnityDataFiles Include="$(SkillsJsonSource)" Condition="Exists('$(SkillsJsonSource)')" />
      <UnityDataFiles Include="$(ClassesJsonSource)" Condition="Exists('$(ClassesJsonSource)')" />
      <UnityDataFiles Include="$(UpgradeJsonSource)" Condition="Exists('$(UpgradeJsonSource)')" />
      <UnityMapFiles Include="$(MapsDataDir)**/*.json" Condition="Exists('$(MapsDataDir)')" />
      <UnityMapFiles Include="$(MapsDataDir)**/*.bin" Condition="Exists('$(MapsDataDir)')" />
    </ItemGroup>
    <Copy SourceFiles="@(UnityPluginFiles)" DestinationFolder="$(UnityPluginsDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(UnityDataFiles)" DestinationFolder="$(UnityDataDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(UnityMapFiles)" DestinationFiles="@(UnityMapFiles->'$(UnityDataDir)maps/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
